.venv/
__pycache__/
*.pyc
.pytest_cache/
# Race data stays on the Pi. Keep the directory, never the races in it.
races/*
!races/.gitkeep
# Runner registrations, bib assignments and tag pairs. Real people's data; the
# repo is public. Matched in either case so a Data or data folder is covered
# whatever core.ignorecase says.
[Dd][Aa][Tt][Aa]/
pairs.csv
# Copies of Data/ taken before re-running assign_bibs.py hold the same runner data.
[Dd][Aa][Tt][Aa]_[Bb][Aa][Cc][Kk][Uu][Pp]*/
# RunSignup API key and secret for tools/post_runsignup_result.py. Never commit.
.env
